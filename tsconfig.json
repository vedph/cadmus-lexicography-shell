/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "esModuleInterop": true,
    "paths": {
      "@myrmidon/cadmus-part-lexicography-lemma": [
        "./dist/myrmidon/cadmus-part-lexicography-lemma"
      ],
      "@myrmidon/cadmus-part-lexicography-pg": [
        "./dist/myrmidon/cadmus-part-lexicography-pg"
      ],
      "@myrmidon/cadmus-part-lexicography-word-collocations": [
        "./dist/myrmidon/cadmus-part-lexicography-word-collocations"
      ],
      "@myrmidon/cadmus-part-lexicography-word-forms": [
        "./dist/myrmidon/cadmus-part-lexicography-word-forms"
      ],
      "@myrmidon/cadmus-part-lexicography-word-senses": [
        "./dist/myrmidon/cadmus-part-lexicography-word-senses"
      ]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "moduleResolution": "bundler",
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./projects/myrmidon/cadmus-part-lexicography-lemma/tsconfig.lib.json"
    },
    {
      "path": "./projects/myrmidon/cadmus-part-lexicography-lemma/tsconfig.spec.json"
    },
    {
      "path": "./projects/myrmidon/cadmus-part-lexicography-pg/tsconfig.lib.json"
    },
    {
      "path": "./projects/myrmidon/cadmus-part-lexicography-pg/tsconfig.spec.json"
    },
    {
      "path": "./projects/myrmidon/cadmus-part-lexicography-word-forms/tsconfig.lib.json"
    },
    {
      "path": "./projects/myrmidon/cadmus-part-lexicography-word-forms/tsconfig.spec.json"
    },
    {
      "path": "./projects/myrmidon/cadmus-part-lexicography-word-senses/tsconfig.lib.json"
    },
    {
      "path": "./projects/myrmidon/cadmus-part-lexicography-word-senses/tsconfig.spec.json"
    },
    {
      "path": "./projects/myrmidon/cadmus-part-lexicography-word-collocations/tsconfig.lib.json"
    },
    {
      "path": "./projects/myrmidon/cadmus-part-lexicography-word-collocations/tsconfig.spec.json"
    }
  ]
}
